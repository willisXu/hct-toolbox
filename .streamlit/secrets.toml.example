# =====================================================================
# Streamlit Secrets 範例 — 部署到 Streamlit Community Cloud 時，
# 把整段（填入實際值後）貼到 App 的 ⋮ → Settings → Secrets，按 Save changes。
# 本機測試則複製為 .streamlit/secrets.toml（已被 .gitignore 擋住）。
#
# 已填好實際值的「貼上用」版本：專案根目錄的 secrets.貼上用.toml
# （同樣被 .gitignore 擋住，不會上 GitHub）。機密內容，絕對不要 commit 進 git。
#
# ※ TOML 規定：頂層的 KEY = 值 一定要放在第一個 [區塊] 之前，
#   放到後面會被當成上一個區塊的欄位。
# =====================================================================

# --- 頁面密碼（選填）：開頁面一律要先輸入密碼 ---
# 不設 = 用程式內建的密碼（app.py 只存雜湊）。要換密碼才設這行，
# 建議 12 碼以上、避免好猜的組合；人員異動時換一組即可。
# HCT_APP_PASSWORD = "<新密碼>"

# --- NetSuite 連線（「🔗 NetSuite 直接抓取」分頁用；沒設該分頁無法使用） ---
[netsuite]
account_id = "<your_account_id>"          # 正式區帳號 ID
consumer_key = ""
consumer_secret = ""
token_id = ""
token_secret = ""
# 部署 netsuite_restlet/saved_search_restlet.js 後取得的正式區 RESTlet 網址
# （見 netsuite_restlet/README.md）：
restlet_url = "https://<your_account_id>.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=<script_id>&deploy=<deploy_id>"

# --- 轉出紀錄存 Google 試算表（建議設定） ---
# 省略的話紀錄存在伺服器本機檔案，雲端部署重啟就會清空。設定步驟見 README。
[gsheet_log]
# 試算表網址或 ID 都可以
spreadsheet_id = "https://docs.google.com/spreadsheets/d/<spreadsheet_id>/edit"
worksheet = "轉出紀錄"                       # 分頁名稱，不存在時程式會自動建立

# 把 Google Cloud 服務帳戶金鑰 JSON 的內容整份貼進來，
# 並記得把試算表分享給下面的 client_email，權限給「編輯者」。
[gsheet_log.service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = """-----BEGIN PRIVATE KEY-----
<多行金鑰原樣貼進來>
-----END PRIVATE KEY-----
"""
client_email = "<name>@<project>.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
