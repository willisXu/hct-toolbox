# 複製成 .streamlit/secrets.toml（本機）或貼進 Streamlit Community Cloud
# 的 App settings → Secrets（雲端），機密內容，絕對不要 commit 進 git。

[netsuite]
account_id = "11776409"          # 正式區；sandbox 為 11776409_SB1
consumer_key = ""
consumer_secret = ""
token_id = ""
token_secret = ""
# 部署 netsuite_restlet/saved_search_restlet.js 後，
# 依 netsuite_restlet/README.md 組出的完整 RESTlet 網址：
restlet_url = ""
